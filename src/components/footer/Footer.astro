---
import { fade } from "astro:transitions";
import cvIcon from "public/assets/cv-icon.png";
import gitHubIcon from "public/assets/github-icon.png";
import linkedinIcon from "public/assets/linkedin-icon.png";

import Icon from "@/components/icon/Icon.astro";
import { getLangFromUrl } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const cvLink = lang === "en" ? "/pdf/cv-en.pdf" : "/pdf/cv-pt_br.pdf";
---

<footer
  class="mt-4 w-full bg-background"
  transition:animate={fade({ duration: "500ms" })}
>
  <div
    class="border-secondary-800 flex flex-row items-center justify-center border-t bg-radial-gradient-top from-secondary from-0% to-background to-90% py-4 sm:py-0"
  >
    <a
      href="https://www.linkedin.com/in/lnormanha"
      class="btn btn-ghost flex flex-row items-center justify-center px-4 py-2 font-heading hover:bg-primary/10 sm:px-6"
    >
      <Icon icon={linkedinIcon} />
      <span class="ml-2 text-sm sm:text-base">LinkedIn</span>
    </a>
    <a
      href="https://github.com/lnormanha"
      class="btn btn-ghost flex flex-row items-center justify-center px-4 py-2 font-heading hover:bg-primary/10 sm:px-6"
    >
      <Icon icon={gitHubIcon} />
      <span class="ml-2 text-sm sm:text-base">GitHub</span>
    </a>
    <a
      href={cvLink}
      target="_blank"
      class="btn btn-ghost flex flex-row items-center justify-center px-4 py-2 font-heading hover:bg-primary/10 sm:px-6"
    >
      <Icon icon={cvIcon} />
      <span class="ml-2 text-sm sm:text-base">CV</span>
    </a>
  </div>
</footer>
