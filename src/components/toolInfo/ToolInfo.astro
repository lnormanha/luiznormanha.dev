---
interface Props {
  name: string;
  description: string;
}
const { name, description } = Astro.props;
---

<li class="flex flex-col space-y-1 sm:flex-row sm:space-x-2 sm:space-y-0">
  <span class="text-base font-bold sm:text-lg">{name}</span>
  <span class="hidden text-lg font-bold sm:inline">-</span>
  <span class="text-sm sm:text-lg">{description}</span>
</li>
