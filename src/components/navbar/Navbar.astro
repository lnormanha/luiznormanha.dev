---
import { Image } from "astro:assets";
import { fade } from "astro:transitions";
import logo from "public/assets/LN_Logo_Transparent.svg";

import { getLangFromUrl, getLanguagePath, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const switchToLang = getLanguagePath(Astro.url);

const langPath = lang === "en" ? "/" : "/pt-br/";
---

<nav
  class="flex w-full flex-row items-center justify-between bg-background px-2 sm:px-4"
>
  <a
    class="flex h-12 w-12 flex-col items-center justify-center rounded-xl hover:bg-primary/5 sm:h-16 sm:w-16"
    href={`${langPath}`}
  >
    <Image
      src={logo}
      alt="LN Dev Logo"
      decoding="async"
      loading="lazy"
      class="h-16 w-16 object-contain sm:h-20 sm:w-20"
    />
  </a>
  <div
    class="border-secondary-800 flex h-full flex-1 flex-row items-center justify-center border-b bg-radial-gradient-bottom from-secondary from-0% to-background to-90%"
  >
    <a
      transition:animate={fade({ duration: "500ms" })}
      class="btn btn-ghost px-2 font-heading text-sm text-accent hover:bg-primary/10 sm:px-4 sm:text-xl"
      href=`${langPath}about/`
    >
      {(t("navbar.about") as string).toUpperCase()}
    </a>
    <a
      transition:animate={fade({ duration: "500ms" })}
      class="btn btn-ghost px-2 font-heading text-sm text-accent hover:bg-primary/10 sm:px-4 sm:text-xl"
      href=`${langPath}tools/`
    >
      {(t("navbar.tools") as string).toUpperCase()}
    </a>
  </div>
  <div
    class="flex h-12 w-12 flex-col items-center justify-center sm:h-16 sm:w-16"
  >
    <a
      class="btn z-10 h-12 w-12 rounded-[8px] border border-primary-400 bg-[radial-gradient(circle_at_bottom,_var(--tw-gradient-stops))] from-secondary from-0% to-background to-90% p-0 font-heading text-sm font-bold text-primary hover:border-primary/50 sm:h-16 sm:w-16 sm:text-lg"
      href={switchToLang}
    >
      <p transition:animate={fade({ duration: "500ms" })}>
        {lang.toUpperCase()}
      </p>
    </a>
  </div>
</nav>
