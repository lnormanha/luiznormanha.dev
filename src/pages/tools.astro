---
import { fade } from "astro:transitions";

import ToolInfo from "@/components/toolInfo/ToolInfo.astro";
import ScrollLayout from "@/layouts/ScrollLayout.astro";

import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { tools } from "../static/content/tools";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatedTools = tools[lang];
---

<ScrollLayout>
  <section
    class="flex w-full flex-col space-y-4 px-4 sm:px-0"
    transition:animate={fade({ duration: "500ms" })}
  >
    <h1
      class="text-center font-heading text-2xl font-bold sm:text-left sm:text-4xl"
    >
      {t("tools.title")}
    </h1>
    <p class="text-sm font-medium sm:text-base">
      {t("tools.description")}
    </p>
  </section>

  <section
    class="flex w-full flex-1 flex-col space-y-8 px-4 sm:px-0"
    transition:animate={fade({ duration: "500ms" })}
  >
    {
      translatedTools.map((section) => {
        return (
          <div class="flex flex-col space-y-4">
            <h2 class="font-heading text-lg font-bold sm:text-xl">
              {section.title}
            </h2>
            <ul class="space-y-6">
              {section.tools.map((tool) => (
                <ToolInfo {...tool} />
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>
</ScrollLayout>
